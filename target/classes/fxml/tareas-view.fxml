<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.monedero.controller.TareaController"
            styleClass="view-scroll">
    <VBox spacing="20.0" styleClass="view-container">
        <VBox spacing="4.0">
            <Label text="Lista de Tareas" styleClass="view-title"/>
            <Label text="CRUD basico para crear, editar, completar y eliminar tus tareas financieras." styleClass="view-subtitle"/>
        </VBox>

        <VBox spacing="14.0" styleClass="card">
            <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
            <Label text="Gestionar tarea" styleClass="card-title"/>
            <FlowPane hgap="12.0" vgap="12.0">
                <TextField fx:id="txtTitulo" promptText="Titulo de la tarea" prefWidth="220.0" styleClass="input-field"/>
                <TextField fx:id="txtDescripcion" promptText="Descripcion breve" prefWidth="260.0" styleClass="input-field"/>
                <DatePicker fx:id="dateLimite" prefWidth="160.0" styleClass="input-field"/>
                <Button text="Agregar" onAction="#agregarTarea" styleClass="btn-primary"/>
                <Button text="Guardar Edicion" onAction="#actualizarTarea" styleClass="btn-secondary"/>
            </FlowPane>
            <Label fx:id="lblMensaje" text="" styleClass="status-msg"/>
        </VBox>

        <VBox spacing="12.0" VBox.vgrow="ALWAYS" styleClass="card">
            <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Tareas registradas" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Completar / Reabrir" onAction="#alternarCompletada" styleClass="btn-secondary"/>
                <Button text="Eliminar" onAction="#eliminarTarea" styleClass="btn-danger"/>
            </HBox>
            <TableView fx:id="tablaTareas" VBox.vgrow="ALWAYS" minHeight="260.0" styleClass="modern-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colTitulo" text="Titulo"/>
                    <TableColumn fx:id="colDescripcion" text="Descripcion"/>
                    <TableColumn fx:id="colFecha" text="Fecha Limite"/>
                    <TableColumn fx:id="colEstado" text="Estado"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
