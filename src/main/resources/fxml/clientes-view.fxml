<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.monedero.controller.ClienteController"
            styleClass="view-scroll">
    <VBox spacing="20.0" styleClass="view-container">
        <VBox spacing="4.0">
            <Label text="Mi Perfil" styleClass="view-title"/>
            <Label text="Consulta y actualiza la informacion personal de tu cuenta activa." styleClass="view-subtitle"/>
        </VBox>

        <HBox spacing="16.0">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="card">
                <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
                <Label text="Rango actual" styleClass="kpi-label"/>
                <Label fx:id="lblRango" text="BRONCE" styleClass="kpi-value"/>
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="card">
                <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
                <Label text="Puntos acumulados" styleClass="kpi-label"/>
                <Label fx:id="lblPuntos" text="0 pts" styleClass="kpi-value"/>
            </VBox>
        </HBox>

        <VBox spacing="6.0" styleClass="card">
            <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
            <Label text="Ventajas de tu rango" styleClass="card-title"/>
            <Label fx:id="lblBeneficiosRango" text="-" styleClass="view-subtitle"/>
        </VBox>

        <VBox spacing="14.0" maxWidth="540.0" styleClass="card">
            <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
            <Label text="Datos personales" styleClass="card-title"/>
            <VBox spacing="6.0">
                <Label text="Nombre completo" styleClass="header-label"/>
                <TextField fx:id="txtNombre" styleClass="input-field"/>
            </VBox>
            <VBox spacing="6.0">
                <Label text="Correo electronico (identificador de sesion)" styleClass="header-label"/>
                <TextField fx:id="txtCorreo" editable="false" styleClass="input-field"/>
            </VBox>
            <VBox spacing="6.0">
                <Label text="Telefono" styleClass="header-label"/>
                <TextField fx:id="txtTelefono" styleClass="input-field"/>
            </VBox>
            <Button text="Guardar Cambios" onAction="#guardarCambios" styleClass="btn-primary"/>
            <Label fx:id="lblMensaje" text="" styleClass="status-msg"/>
        </VBox>
    </VBox>
</ScrollPane>
