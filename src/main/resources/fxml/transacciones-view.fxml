<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.monedero.controller.TransaccionController"
            styleClass="view-scroll">
    <VBox spacing="20.0" styleClass="view-container">
        <VBox spacing="4.0">
            <Label text="Operaciones y Transacciones" styleClass="view-title"/>
            <Label text="Realiza depositos, retiros, transferencias o revierte movimientos completados." styleClass="view-subtitle"/>
        </VBox>

        <VBox spacing="14.0" styleClass="card">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>
            <Label text="Nueva operacion" styleClass="card-title"/>
            <FlowPane hgap="12.0" vgap="12.0">
                <ComboBox fx:id="comboTipo" prefWidth="160.0" styleClass="combo-modern"/>
                <ComboBox fx:id="comboOrigen" promptText="Monedero origen" prefWidth="210.0" styleClass="combo-modern"/>
                <ComboBox fx:id="comboDestino" promptText="Monedero destino" prefWidth="210.0" styleClass="combo-modern"/>
                <TextField fx:id="txtMonto" promptText="Monto ($)" prefWidth="140.0" styleClass="input-field"/>
                <TextField fx:id="txtDescripcion" promptText="Descripcion" prefWidth="220.0" styleClass="input-field"/>
                <Button text="Ejecutar Operacion" onAction="#ejecutarOperacion" styleClass="btn-primary"/>
            </FlowPane>
            <Label fx:id="lblMensaje" text="" styleClass="status-msg"/>
        </VBox>

        <VBox spacing="12.0" VBox.vgrow="ALWAYS" styleClass="card">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label text="Historial del cliente" styleClass="card-title"/>
                <ComboBox fx:id="comboFiltroTipo" prefWidth="160.0" styleClass="combo-modern"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Revertir Seleccionada" onAction="#revertirSeleccionada" styleClass="btn-danger"/>
            </HBox>
            <TableView fx:id="tablaTransacciones" VBox.vgrow="ALWAYS" minHeight="260.0" styleClass="modern-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colFecha" text="Fecha"/>
                    <TableColumn fx:id="colTipo" text="Tipo"/>
                    <TableColumn fx:id="colMonto" text="Monto"/>
                    <TableColumn fx:id="colEstado" text="Estado"/>
                    <TableColumn fx:id="colPuntos" text="Puntos"/>
                    <TableColumn fx:id="colAtipica" text="Atipica"/>
                    <TableColumn fx:id="colDescripcion" text="Descripcion"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
