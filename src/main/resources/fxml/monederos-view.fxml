<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.monedero.controller.MonederoController"
            styleClass="view-scroll">
    <VBox spacing="20.0" styleClass="view-container">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="4.0">
                <Label text="Mis Monederos" styleClass="view-title"/>
                <Label text="Administra multiples monederos por finalidad y transfiere saldo entre ellos." styleClass="view-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotalSaldo" text="Saldo total: 0.00" styleClass="kpi-highlight"/>
        </HBox>

        <VBox spacing="14.0" styleClass="card">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>
            <Label text="Crear nuevo monedero" styleClass="card-title"/>
            <FlowPane hgap="12.0" vgap="12.0">
                <TextField fx:id="txtNombreMonedero" promptText="Ej: Ahorros, Gastos Diarios" prefWidth="240.0" styleClass="input-field"/>
                <TextField fx:id="txtSaldoInicial" promptText="Saldo inicial (ej: 500.00)" prefWidth="200.0" styleClass="input-field"/>
                <Button text="Crear Monedero" onAction="#crearMonedero" styleClass="btn-primary"/>
                <Button text="Activar / Desactivar Seleccionado" onAction="#alternarEstado" styleClass="btn-secondary"/>
            </FlowPane>
            <Label fx:id="lblMensaje" text="" styleClass="status-msg"/>
        </VBox>

        <VBox spacing="14.0" styleClass="card">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>
            <Label text="Transferir entre mis monederos (sin comision)" styleClass="card-title"/>
            <FlowPane hgap="12.0" vgap="12.0">
                <ComboBox fx:id="comboOrigenPropio" promptText="Desde mi monedero" prefWidth="210.0" styleClass="combo-modern"/>
                <ComboBox fx:id="comboDestinoPropio" promptText="Hacia mi monedero" prefWidth="210.0" styleClass="combo-modern"/>
                <TextField fx:id="txtMontoTransferencia" promptText="Monto ($)" prefWidth="140.0" styleClass="input-field"/>
                <TextField fx:id="txtDescTransferencia" promptText="Descripcion (opcional)" prefWidth="200.0" styleClass="input-field"/>
                <Button text="Transferir entre mis cuentas" onAction="#transferirEntrePropios" styleClass="btn-primary"/>
            </FlowPane>
            <Label fx:id="lblMensajeTransferencia" text="" styleClass="status-msg"/>
        </VBox>

        <VBox spacing="12.0" VBox.vgrow="ALWAYS" styleClass="card">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>
            <Label text="Cuentas disponibles" styleClass="card-title"/>
            <TableView fx:id="tablaMonederos" VBox.vgrow="ALWAYS" minHeight="240.0" styleClass="modern-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre"/>
                    <TableColumn fx:id="colSaldo" text="Saldo Actual"/>
                    <TableColumn fx:id="colEstado" text="Estado"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
